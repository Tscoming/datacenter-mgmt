# Copy this file to .env.production and replace the password before deployment.
POSTGRES_DB=datacenter_mgmt
POSTGRES_USER=datacenter
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Published application endpoint.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8008

# Optional image name used by compose build/pull workflows.
APP_IMAGE=datacenter-mgmt:latest
