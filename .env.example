# Backend HTTP server
HOST=127.0.0.1
PORT=8008

# Frontend dev server
FRONTEND_PORT=8000

# API data source: mock | database
API_DATA_SOURCE=mock

# Cabinet telemetry collectors (JSON array, one source per registered cabinet)
CABINET_TELEMETRY_LOW_FREQUENCY_SECONDS=60
CABINET_TELEMETRY_HIGH_FREQUENCY_SECONDS=2

# PostgreSQL connection used when API_DATA_SOURCE=database
PGHOST=ubuntu.home.lab
PGPORT=5432
PGDATABASE=mydb
PGUSER=postgres
PGPASSWORD=password
PGSCHEMA=dcim_ontology_demo_20260623083835

# At least 32 random characters, used to encrypt managed private keys.
# example: u7Kp3xN9qL2vR8mT5cW1zY6bH4dF0sEa
KEY_MANAGEMENT_SECRET=replace-with-at-least-32-random-characters

